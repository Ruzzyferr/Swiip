{
  "name": "swiip",
  "version": "0.1.0",
  "private": true,
  "description": "Swiip — gerekcesi gorunur AI antrenor ve beslenme kocu",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ceviri": "node scripts/ceviri-denetimi.mjs",
    "guvenlik": "node scripts/guvenlik-denetimi.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run ceviri && npm run test",
    "db:generate": "npm -w @swiip/api run db:generate",
    "db:migrate": "npm -w @swiip/api run db:migrate",
    "db:seed": "npm -w @swiip/api run db:seed",
    "api:dev": "npm -w @swiip/api run dev",
    "mobile:start": "npm -w @swiip/mobile run start"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "js-yaml": "^5.3.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.2.7"
  }
}
