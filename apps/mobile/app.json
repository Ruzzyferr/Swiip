{
  "expo": {
    "name": "Swiip",
    "slug": "swiip",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "swiip",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/acilis.png",
      "resizeMode": "contain",
      "backgroundColor": "#ECEEED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.swiip",
      "infoPlist": {
        "NSCameraUsageDescription": "Vücut analizi için fotoğraf çekilir. Fotoğrafın analiz edildikten sonra anında silinir, sunucumuzda saklanmaz.",
        "NSPhotoLibraryUsageDescription": "Vücut analizi için galeriden fotoğraf seçebilirsin. Fotoğraf sunucumuzda saklanmaz.",
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "app.swiip",
      "adaptiveIcon": {
        "foregroundImage": "./assets/uyarlanabilir-ikon.png",
        "backgroundColor": "#131614"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Vücut analizi ve barkod okuma için kamera gerekiyor. Fotoğrafın analiz edildikten sonra anında silinir, sunucumuzda saklanmaz.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Fotoğrafı çekerken telefonun dik olup olmadığını ivmeölçerden okuyoruz. Aynı açıyla çekilmeyen iki fotoğraf karşılaştırılamaz."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14615A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2953141598487358~8715281071",
          "iosAppId": "ca-app-pub-2953141598487358~5056357841",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Sana daha alakali reklamlar gosterebilmemiz icin. Izin vermezsen de uygulamanin tamami calismaya devam eder; yalnizca reklamlar genel olur."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/ikon.png",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c4125b70-2cde-4270-88a4-f231d1ad4eb0"
      }
    },
    "owner": "ruzzyferr"
  }
}
