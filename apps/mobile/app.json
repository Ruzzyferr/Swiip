{
  "expo": {
    "name": "Swiip",
    "slug": "swiip",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "swiip",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/acilis.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.swiip",
      "infoPlist": {
        "NSCameraUsageDescription": "Vücut analizi için fotoğraf çekilir. Fotoğrafın analiz edildikten sonra anında silinir, sunucumuzda saklanmaz.",
        "NSPhotoLibraryUsageDescription": "Vücut analizi için galeriden fotoğraf seçebilirsin. Fotoğraf sunucumuzda saklanmaz.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "app.swiip",
      "adaptiveIcon": {
        "foregroundImage": "./assets/uyarlanabilir-ikon.png",
        "backgroundColor": "#131614"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"],
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Vücut analizi ve barkod okuma için kamera gerekiyor. Fotoğrafın analiz edildikten sonra anında silinir, sunucumuzda saklanmaz.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14615A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/ikon.png",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c4125b70-2cde-4270-88a4-f231d1ad4eb0"
      }
    },
    "owner": "ruzzyferr"
  }
}
