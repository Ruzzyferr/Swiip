# Mobil derleme değişkenleri. EXPO_PUBLIC_ öneki olanlar pakete gömülür —
# buraya gizli anahtar yazma; bunlar istemci tarafı anahtarlardır.

# API adresi. Boşsa geliştirme varsayılanı kullanılır.
EXPO_PUBLIC_API_URL=

# RevenueCat istemci anahtarları (platform başına ayrı).
# Boşsa uygulama açılır ve paywall görünür, yalnızca satın alma kapalı kalır.
EXPO_PUBLIC_REVENUECAT_IOS=
EXPO_PUBLIC_REVENUECAT_ANDROID=
