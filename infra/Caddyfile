# Swiip ters vekil. TLS sertifikaları Caddy tarafından otomatik alınır ve yenilenir.

{$ALAN_ADI} {
	encode zstd gzip

	# Güvenlik başlıkları. HSTS'i yalnızca alan adı gerçekten yayındayken açık tut.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Sağlık ucu log'u şişirmesin.
	@saglik path /saglik
	log_skip @saglik

	# API ve marka sitesi AYNI ORIGIN'den sunuluyor.
	#
	# Sitenin tek dinamik ucu yayın haberi formu; ayrı bir alan adına koymak yalnızca
	# CORS ve çerez sorunu üretirdi. Uygulama ise zaten mutlak adres kullanıyor.
	@api path /v1/* /saglik
	handle @api {
		reverse_proxy api:3000 {
			# Vücut fotoğrafı isteği büyük olabilir; zaman aşımı buna göre.
			transport http {
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	handle {
		root * /site

		# Bilinmeyen yol ANA SAYFAYA düşmez.
		#
		# Burada `try_files {path} {path}/ /index.html` yazıyordu — tek sayfalık bir
		# uygulama kalıbı. Ama `apps/site` bir SPA değil, üç statik sayfa. Sonucu şuydu:
		# YANLIŞ YAZILMIŞ HER YOL 200 ile ana sayfayı döndürüyordu.
		#
		#   /gizlilik      -> 200, ana sayfa   (uzantı unutulmuş bir gizlilik bağlantısı)
		#   /destek.html   -> 200, ana sayfa   (olmayan bir sayfaya verilmiş bağlantı)
		#   /.env          -> 200, ana sayfa
		#
		# `apps/mobile/src/baglantilar.ts` bu tuzağı biliyor ve bağlantılara `.html`
		# ekleyerek kaçınmaya çalışıyor — ama yukarıdaki ikinci satır gösteriyor ki
		# `.html` de kurtarmıyor. Kırık bir gizlilik bağlantısı kırık GÖRÜNMÜYOR;
		# pazarlama sayfası açılıyor ve kimse fark etmiyor. Mağaza incelemesinde
		# gizlilik/destek bağlantısı tıklanan ilk şeylerden biri.
		#
		# `{path}.html` bilerek deneniyor: `/gizlilik` artık ana sayfayı değil
		# `gizlilik.html`'i açıyor. Kalan her şey `handle_errors`a düşüyor.
		try_files {path} {path}.html {path}/index.html
		file_server

		# Yazı tipleri ve işaret uzun süre önbelleklenebilir; HTML asla.
		@varlik path /varliklar/* /stil.css /script.js
		header @varlik Cache-Control "public, max-age=604800"
		@html path / /index.html
		header @html Cache-Control "no-cache"
	}

	# Bulunamayan sayfa GERÇEKTEN 404 döner ve bir sayfası vardır.
	handle_errors {
		root * /site
		rewrite * /404.html
		file_server
	}

	log {
		output file /data/erisim.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}
