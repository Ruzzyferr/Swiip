# infra/.env — sunucuda bu dosya oluşturulur, deposuna ASLA girmez.

ALAN_ADI=swiip.app

POSTGRES_USER=swiip
POSTGRES_DB=swiip
# openssl rand -base64 32
POSTGRES_PASSWORD=

# En az 32 karakter: openssl rand -base64 48
JWT_SECRET=

# Boş bırakılırsa motor deterministik yedeklerle çalışır; program yine üretilir.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=

# RevenueCat web kancası sırrı. RevenueCat panelinde Authorization başlığı olarak ayarlanır.
# Boşsa kanca ucu HİÇ açılmaz — doğrulanmamış kanca ödeme duvarını herkese açar.
# openssl rand -base64 48
REVENUECAT_KANCA_SIRRI=

# Kimlik uçları için dakikalık istek sınırı (giriş, kayıt, parola sıfırlama ortak havuz).
# Genel sınır 120/dk; parola denemesi için fazla gevşek olduğundan ayrı tutuluyor.
KIMLIK_ISTEK_SINIRI=10

# Posta sağlayıcısı (Resend, Postmark, Mailgun vb.). Boşsa kodlar yalnızca loga düşer.
POSTA_API_URL=
POSTA_API_KEY=
POSTA_GONDEREN=Swiip <merhaba@swiip.app>

# Analitik uçlarını açar. Boşsa uçlar kapalı. openssl rand -base64 48
YONETIM_ANAHTARI=

LOG_SEVIYESI=info
CORS_KAYNAKLAR=*
YEDEK_SAKLAMA_GUN=30

# Dışarı kopyalama (rclone remote adı). Boşsa yedek yalnızca sunucuda kalır — yeterli değil.
YEDEK_UZAK_HEDEF=
